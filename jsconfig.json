{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "src/animations/**/*.js",
    "src/studio/canvas-renderer.js",
    "src/studio/commands.js",
    "src/studio/history.js",
    "src/studio/ik.js",
    "src/studio/panels.js",
    "src/studio/persistence.js",
    "src/studio/project-io.js",
    "src/studio/project-model.js",
    "src/studio/state.js",
    "src/studio/templates.js",
    "src/studio/timeline.js",
    "src/studio/tutorials.js"
  ]
}
