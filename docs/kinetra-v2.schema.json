{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://masterpet22.github.io/kinetra/schema/kinetra-v2.schema.json",
  "title": "Paquete Kinetra v2",
  "type": "object",
  "required": ["schema", "name", "fps", "rig", "assets", "layers", "clips"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "kinetra/v2" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "fps": { "type": "number", "minimum": 1, "maximum": 240 },
    "rig": {
      "type": "object",
      "required": ["id", "name", "bones"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "bones": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": ["id", "name", "x", "y"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "parent": { "type": ["string", "null"] },
              "followTarget": { "const": "torso" },
              "jointOrigin": { "type": "boolean" },
              "motionLimits": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": { "type": "number", "minimum": 0 },
                  "y": { "type": "number", "minimum": 0 },
                  "angle": { "type": "number", "minimum": 0 }
                }
              },
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "src"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "type": { "enum": ["image/png", "image/webp", "image/jpeg"] },
          "src": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 0 },
          "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
          "height": { "type": "integer", "minimum": 1, "maximum": 8192 }
        }
      }
    },
    "layers": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["id", "assetId", "x", "y", "rotation", "scaleX", "scaleY", "z"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "assetId": { "type": "string", "minLength": 1 },
          "source": { "enum": ["asset", "builtin"] },
          "boneId": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "rotation": { "type": "number" },
          "restRotation": { "type": "number" },
          "scaleX": { "type": "number" },
          "scaleY": { "type": "number" },
          "visible": { "type": "boolean" },
          "z": { "type": "number" },
          "groupId": { "type": "string" },
          "crop": {
            "type": "object",
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": { "type": "number", "minimum": 0 },
              "y": { "type": "number", "minimum": 0 },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    },
    "layerGroups": { "type": "array" },
    "clips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "duration", "loop", "requires", "keys", "spriteEvents"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "state": { "enum": ["idle", "locomotion", "action", "hit", "defeated"] },
          "status": { "enum": ["draft", "integrated"] },
          "duration": { "type": "number", "minimum": 100, "maximum": 60000 },
          "loop": { "type": "boolean" },
          "requires": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "keys": { "type": "object" },
          "spriteEvents": { "type": "array" }
        }
      }
    }
  }
}
